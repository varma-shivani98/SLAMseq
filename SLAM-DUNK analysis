head(pc3_ctrl_thiaG_1hr)
all(rownames(pc3_ctrl_thiaG_1hr) == colnames(X240708_TC_ctrl_conditions))
pc3_ctrl_thiaG_1hr$condition <- factor(pc3_ctrl_thiaG_1hr$condition)
pc3_ctrl_thiaG_1hr$libType <- factor(pc3_ctrl_thiaG_1hr$libType)
dds <- DESeqDataSetFromMatrix(X240708_TC_ctrl_conditions, design = ~condition,colData = pc3_ctrl_thiaG_1hr)
dds$condition <- relevel(dds$condition, ref = "Control")
DEGs <- DESeq(dds, quiet= FALSE)
pc3_C_T_1hr <- results(DEGs, parallel = FALSE,alpha = 0.05, pAdjustMethod = "BH")
summary(pc3_C_T_1hr)
plotMA(pc3_C_T_1hr)
pc3_C_T_1hr_1 <- as.data.frame(pc3_C_T_1hr)
write.table(pc3_C_T_1hr_1, file="240708_ctrl_ThiaG_1hr_slamdunk.txt", sep = "\t" )
